<launch>
  <arg name="rviz" default="false"/>
  <include file="$(find potato_lio_bringup)/launch/lio.launch">
    <arg name="rviz" value="false"/>
  </include>

  <!-- MID-360 optical origin and built-in IMU relative to chassis rotation center. -->
  <node pkg="tf" type="static_transform_publisher" name="base_to_livox"
        args="0.09 0.0 0.138 0 0 0 base_link livox_frame 100"/>
  <node pkg="tf" type="static_transform_publisher" name="base_to_lio_body"
        args="0.076 0.02329 0.09388 0 0 0 base_link body 100"/>

  <node pkg="potato_mapping" type="lio_planar_odom.py" name="lio_planar_odom" output="screen" required="true">
    <param name="input" value="/Odometry"/>
    <param name="output" value="/odom"/>
    <param name="odom_frame" value="odom"/>
    <param name="base_frame" value="base_link"/>
    <param name="base_to_imu_x" value="0.076"/>
    <param name="base_to_imu_y" value="0.02329"/>
    <param name="velocity_alpha" value="0.35"/>
  </node>

  <!-- Height slice rejects floor/ceiling; range_min rejects chassis self-reflections. -->
  <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node"
        name="cloud_to_scan" output="screen" required="true">
    <remap from="cloud_in" to="/cloud_registered_body"/>
    <remap from="scan" to="/scan"/>
    <param name="target_frame" value="base_link"/>
    <param name="transform_tolerance" value="0.05"/>
    <param name="min_height" value="0.05"/>
    <param name="max_height" value="0.50"/>
    <param name="angle_min" value="-3.14159265"/>
    <param name="angle_max" value="3.14159265"/>
    <param name="angle_increment" value="0.008726646"/>
    <param name="scan_time" value="0.10"/>
    <param name="range_min" value="0.35"/>
    <param name="range_max" value="20.0"/>
    <param name="use_inf" value="true"/>
    <param name="inf_epsilon" value="1.0"/>
    <param name="concurrency_level" value="1"/>
  </node>

  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen" required="true">
    <rosparam command="load" file="$(find potato_mapping)/config/gmapping.yaml"/>
    <remap from="scan" to="/scan"/>
  </node>

  <node pkg="potato_mapping" type="mapping_monitor.py" name="mapping_monitor" output="screen"/>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find potato_mapping)/rviz/mapping.rviz" output="screen"/>
</launch>
