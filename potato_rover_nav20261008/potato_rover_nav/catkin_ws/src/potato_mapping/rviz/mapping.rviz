Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
    - Class: rviz/Map
      Name: Occupancy Map
      Enabled: true
      Topic: /map
      Alpha: 0.8
      Color Scheme: map
      Draw Behind: false
    - Class: rviz/LaserScan
      Name: Filtered Scan
      Enabled: true
      Topic: /scan
      Queue Size: 1
      Size (m): 0.025
      Style: Points
      Color Transformer: Intensity
      Decay Time: 0
    - Class: rviz/RobotModel
      Name: Robot TF
      Enabled: false
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Frame Timeout: 5
      Show Axes: true
      Show Arrows: false
      Show Names: true
    - Class: rviz/PointCloud2
      Name: Body Cloud Debug
      Enabled: false
      Topic: /cloud_registered_body
      Queue Size: 1
      Style: Points
      Size (Pixels): 1
      Decay Time: 0
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Angle: 0
      Scale: 30
      X: 0
      Y: 0
Window Geometry:
  Width: 1280
  Height: 800
